# PoshanSathi environment template
# Copy this file to ".env" and fill in real local values.
# NEVER commit the real ".env" file.

# --- Flask ---
FLASK_APP=app.py
FLASK_CONFIG=development
SECRET_KEY=change-me-to-a-random-secret

# --- Database (MySQL) ---
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://poshansathi:poshansathi@localhost:3306/poshansathi
TEST_DATABASE_URL=sqlite:///:memory:

# --- Logging ---
LOG_LEVEL=INFO

# --- Session / authentication (Phase 2) ---
# Lifetime of a "remember me" login, in hours.
SESSION_LIFETIME_HOURS=8
# Set to "true" only when serving over HTTPS.
SESSION_COOKIE_SECURE=false

# --- Optional AI layer (Phase 14 only; leave blank for now) ---
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
